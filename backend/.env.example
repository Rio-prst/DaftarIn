# Application environment type: development | test | production
NODE_ENV=development
# Backend application port
PORT=3000

# Runtime backend connection via Supabase Session Pooler.
# Get from: Supabase > Connect > Session pooler (port 5432, sslmode=require)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# Prisma CLI connection (prisma migrate / db push) via Supabase Direct connection.
# Get from: Supabase > Connect > Direct connection (host db.<ref>.supabase.co, port 5432)
DIRECT_URL="postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require"
# Local test database for integration tests
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/daftarin_test?schema=public"

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key: server only, never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Private Supabase Storage bucket for user documents (bucket must be Public: false).
SUPABASE_STORAGE_BUCKET=documents

# Access token JWT secret, at least 32 random bytes.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
# Access token lifetime
JWT_ACCESS_TTL=15m
# Refresh token lifetime in days (token is stored as a hash in DB)
REFRESH_TOKEN_TTL_DAYS=7
# Enable only for HTTPS/production
COOKIE_SECURE=false
# Cookie domain
COOKIE_DOMAIN=localhost
# Allowed frontend origin, comma-separated if there is more than one
CORS_ORIGIN=http://localhost:3001

# Document inspection queue (BullMQ). Redis runs via docker compose in backend/.
REDIS_URL=redis://localhost:6379
# Number of inspection jobs processed in parallel by the worker
INSPECTION_QUEUE_CONCURRENCY=2

# LLM provider: "disabled" in the baseline
AI_PROVIDER=disabled
# OCR provider: "disabled" in the baseline
OCR_PROVIDER=disabled
# AI provider API key
AI_API_KEY=

# File size limit in bytes (10485760 = 10 MB)
MAX_UPLOAD_BYTES=10485760
# PDF page limit
MAX_PDF_PAGES=20
# Enable/disable Swagger UI (/api/docs)
SWAGGER_ENABLED=true
