NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/daftarin_test?schema=public"

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=documents

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:3001

REDIS_URL=redis://localhost:6379
INSPECTION_QUEUE_CONCURRENCY=2

AI_PROVIDER=disabled
OCR_PROVIDER=disabled
AI_API_KEY=

MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=20
SWAGGER_ENABLED=true
