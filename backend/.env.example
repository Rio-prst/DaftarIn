# ==============================================================================
# DAFTARIN BACKEND CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# PERINGATAN KEAMANAN:
# File ini hanya berisi placeholder dan panduan konfigurasi.
# JANGAN PERNAH menyalin kunci privat, token produksi, atau kredensial rahasia
# ke file ini, laporan evaluasi, dokumentasi, atau git repository.
# ==============================================================================

# Lingkungan aplikasi: development | test | production
NODE_ENV=development

# Port layanan HTTP backend
PORT=3000

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# DATABASE_URL: Koneksi runtime aplikasi (mendukung connection pooler Supabase / PgBouncer)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[require|disable]
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# DIRECT_URL: Koneksi langsung untuk Prisma CLI (prisma migrate dev / deploy / db push)
# Di Supabase, gunakan host direct (port 5432) tanpa pooler.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# DATABASE_URL_TEST: Database terisolasi untuk pengujian integrasi otomatis
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ------------------------------------------------------------------------------
# SUPABASE STORAGE (Penyimpanan Berkas Dokumen Warga)
# ------------------------------------------------------------------------------
# URL project Supabase (misal: https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Key (Hanya di backend server, jangan pernah diekspos ke frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Nama bucket penyimpanan dokumen privat (Harus berstatus Public: false di Supabase)
SUPABASE_STORAGE_BUCKET=documents

# ------------------------------------------------------------------------------
# AUTENTIKASI, JWT & KEAMANAN SESI
# ------------------------------------------------------------------------------
# Secret key penandatanganan JWT Access Token (minimal 32 karakter acak berkualitas tinggi)
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-at-least-32-chars-long

# Masa berlaku access token (misal: 15m, 1h)
JWT_ACCESS_TTL=15m

# Masa berlaku refresh session token dalam hari (tersimpan dalam bentuk hash di database)
REFRESH_TOKEN_TTL_DAYS=7

# COOKIE_SECURE:
# - false : untuk pengujian lokal berbasis HTTP (http://127.0.0.1 atau http://localhost)
# - true  : WAJIB untuk produksi berbasis HTTPS (Vercel, Railway, VPS ber-SSL)
COOKIE_SECURE=false

# Domain cookie (kosongkan atau sesuaikan domain root jika frontend & backend berbagi subdomain)
COOKIE_DOMAIN=localhost

# CORS_ORIGIN:
# Alamat asal frontend yang diizinkan mengakses API (mendukung pemisahan koma untuk multi-origin)
# Contoh lokal: http://127.0.0.1:5174,http://localhost:5174
# Contoh produksi: https://daftarin.vercel.app,https://daftarin.id
CORS_ORIGIN=http://127.0.0.1:5174

# ------------------------------------------------------------------------------
# ANTRIAN TUGAS ASINKRON (BullMQ & Redis)
# ------------------------------------------------------------------------------
# URL koneksi Redis untuk antrean pekerjaan latar belakang
REDIS_URL=redis://localhost:6379

# Jumlah pemrosesan antrian inspeksi paralel
INSPECTION_QUEUE_CONCURRENCY=2

# ------------------------------------------------------------------------------
# PEMERIKSAAN DOKUMEN & AI ENGINE
# ------------------------------------------------------------------------------
# Status provider AI/OCR untuk inspeksi dokumen:
# Opsi: "gemini" | "disabled"
# Bila menggunakan Gemini, pastikan AI_API_KEY atau CHAT_GEMINI_API_KEY terisi.
AI_PROVIDER=disabled
OCR_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
INSPECTION_AI_TIMEOUT_MS=30000

# Batas ukuran unggahan berkas dalam byte (10485760 = 10 MB, diselaraskan dengan batas simpan)
MAX_UPLOAD_BYTES=10485760

# Batas maksimum jumlah halaman per berkas PDF
MAX_PDF_PAGES=20

# Dokumentasi Swagger UI (/api/docs)
SWAGGER_ENABLED=true

# ------------------------------------------------------------------------------
# ASISTEN KONSULTASI / CHATBOT PANDUAN WARGA
# ------------------------------------------------------------------------------
# Penyedia model bahasa asisten tanya jawab publik:
# Opsi: "disabled" | "gemini" | "openai_compatible" (alias: "openai")
# Variabel ini milik BACKEND. AI_PROVIDER di atas hanya untuk inspeksi dokumen.
# Nama CHAT_* diprioritaskan. Nama OPENAI_* / GEMINI_* dan VITE_* lama
# masih dapat dibaca di server untuk migrasi; jangan simpan key di frontend.
CHAT_AI_PROVIDER=disabled
CHAT_AI_API_KEY=
CHAT_AI_MODEL=
CHAT_AI_BASE_URL=https://api.openai.com/v1
CHAT_AI_FALLBACK_MODEL=
CHAT_GEMINI_API_KEY=
CHAT_GEMINI_MODEL=
