# ==============================================================================
# DAFTARIN - KONFIGURASI AI (RAG CHATBOT & VISION DOCUMENT VERIFICATION)
# ==============================================================================
# Salin berkas ini menjadi .env dan masukkan API Key Anda.
# JANGAN commit berkas .env ke Git!

# 1. Pilih AI Provider:
# - "openai" (Kompatibel dengan AtmoRouter, OpenAI, Groq, OpenRouter)
# - "gemini" (Google Gemini AI Studio langsung)
VITE_AI_PROVIDER=openai

# 2. Pengaturan AtmoRouter / OpenAI-compatible:
VITE_OPENAI_API_KEY=your_api_key_here
VITE_OPENAI_BASE_URL=https://atmorouter.dev/v1
VITE_OPENAI_MODEL=cb/deepseek-v4.1-flash

# 3. Pengaturan Google Gemini Langsung (Opsional):
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash
