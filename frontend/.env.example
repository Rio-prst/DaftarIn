# demo: akun dan alur contoh lokal; api: autentikasi cookie backend feat/backend.
# Mode api belum menyambungkan API persiapan, dokumen, dan tinjauan.
VITE_AUTH_MODE=demo
# Relative URL uses Vite proxy locally; production requires reverse proxy /api.
VITE_API_URL=/api

# Chatbot uses /api/chat via backend in both modes. Configure CHAT_AI_* only
# in backend secrets; never place provider keys in VITE_* variables.
